# Portul serverului (Render.com setează automat PORT)
PORT=3000

# Parola administratorului (schimbă-o obligatoriu!)
ADMIN_PASSWORD=parola_ta_secreta

# Secret pentru JWT (generează un string aleator lung)
JWT_SECRET=schimba_acest_secret_cu_ceva_aleator_si_lung

# Tipul bazei de date: "sqlite" sau "postgres"
DB_TYPE=sqlite

# URL-ul bazei de date PostgreSQL (doar pentru producție / Render.com)
# DATABASE_URL=postgresql://user:password@host:port/dbname
