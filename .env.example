# Portul serverului (Render.com setează automat PORT)
PORT=3000

# Parola administratorului (schimbă-o obligatoriu!)
ADMIN_PASSWORD=parola_ta_secreta

# Secret pentru JWT (generează un string aleator lung)
JWT_SECRET=schimba_acest_secret_cu_ceva_aleator_si_lung

# Tipul bazei de date: "sqlite" sau "postgres" (opțional dacă este definit DATABASE_URL)
DB_TYPE=sqlite

# URL-ul bazei de date PostgreSQL (Render.com / Supabase)
# Când DATABASE_URL este configurat, serverul activează automat pachetul pg și inițializează tabelele products și admins
# DATABASE_URL=postgresql://postgres:[PAROLA]@db.[PROJECT-REF].supabase.co:5432/postgres
